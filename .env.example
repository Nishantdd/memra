HOST=127.0.0.1
PORT=3000
# Public HTTPS origin served by the reverse proxy; used for Origin checks.
MEMRA_PUBLIC_ORIGIN=
MEMRA_TRUST_PROXY=true
# 1 only for plain-http://localhost development (disables Secure cookies + HSTS).
MEMRA_INSECURE_DEV=0
MEMRA_DATA_DIR=./data
MEMRA_PROFILE=low
MEMRA_EMBEDDING_PROVIDER=local
MEMRA_EMBEDDING_MODEL=
MEMRA_EMBEDDING_BASE_URL=
MEMRA_EMBEDDING_API_KEY=
MEMRA_EMBEDDING_DIMS=
MEMRA_EMBED_WARMUP=
MEMRA_RERANKER=
MEMRA_SEM_MIN_SIM=0.30
MEMRA_WORKER_RSS_LIMIT_MB=350
MEMRA_LLM_PROVIDER=none
MEMRA_LLM_BASE_URL=
MEMRA_LLM_API_KEY=
MEMRA_LLM_MODEL=
MEMRA_LOG_LEVEL=info
NODE_OPTIONS=--max-old-space-size=384
