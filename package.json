{
  "name": "memra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "start": "vp run -r --parallel start",
    "check": "vp check",
    "format": "vp fmt",
    "ready": "vp check && vp run -r build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
